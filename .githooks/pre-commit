#!/bin/sh
# Проверяет согласованность памяти перед коммитом.
# Подключается один раз: git config core.hooksPath .githooks
#
# Хук ничего не изменяет: он только читает файлы и возвращает код проверки.
# Разовый обход, когда очень надо: git commit --no-verify

set -e

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO_ROOT" || exit 0

CHECKER="scripts/check_memory_index.py"
MEMORY_DIR="memory"

[ -d "$MEMORY_DIR" ] || exit 0

if [ ! -f "$CHECKER" ]; then
    echo "pre-commit: хук подключён, но $CHECKER не найден - проверка НЕ идёт." >&2
    echo "pre-commit: скопируйте scripts/ рядом с memory/ либо отключите хук:" >&2
    echo "pre-commit:   git config --unset core.hooksPath" >&2
    exit 0
fi

# Посреди rebase / cherry-pick / merge дерево в промежуточном состоянии,
# и блокировать там нечего: обхода вроде --no-verify у продолжения операции нет.
GIT_DIR_PATH=$(git rev-parse --git-dir 2>/dev/null) || exit 0
for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$GIT_DIR_PATH/$marker" ]; then
        exit 0
    fi
done

# Проверять есть смысл, только когда память вообще участвует в коммите.
# Иначе незакоммиченная правка памяти блокировала бы посторонние коммиты -
# а память правится постоянно, это её нормальное состояние.
if ! git diff --cached --name-only --diff-filter=ACMR -- "$MEMORY_DIR" | grep -q .; then
    exit 0
fi

# Наличие команды ещё не значит, что это нужный Питон: на Windows "python3"
# часто оказывается заглушкой Microsoft Store, а "python" на старых системах -
# второй версией. Поэтому спрашиваем у кандидата версию, а не факт запуска.
PYTHON=""
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c "import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)" \
           >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    echo "pre-commit: Python 3.7+ не найден, проверка памяти пропущена." >&2
    echo "pre-commit: это не значит, что память в порядке - проверка не запускалась." >&2
    echo "pre-commit: поставьте Python 3.7+ либо отключите хук:" >&2
    echo "pre-commit:   git config --unset core.hooksPath" >&2
    exit 0
fi

set +e
"$PYTHON" "$CHECKER" "$MEMORY_DIR" --quiet
STATUS=$?
set -e

case "$STATUS" in
    0)
        exit 0
        ;;
    2)
        # Проверка не смогла выполниться - это не нарушение памяти.
        echo "pre-commit: проверку выполнить не удалось (см. выше), коммит не блокирую." >&2
        exit 0
        ;;
    *)
        echo "pre-commit: память и индекс разошлись - см. список выше." >&2
        echo "pre-commit: разовый обход - git commit --no-verify" >&2
        exit "$STATUS"
        ;;
esac

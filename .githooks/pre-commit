#!/bin/sh
# Проверяет согласованность памяти перед коммитом.
# Подключается один раз: git config core.hooksPath .githooks
#
# Хук ничего не изменяет: он только читает файлы и возвращает код проверки.
# Разовый обход, когда очень надо: git commit --no-verify

set -e

# Печать подсказки не имеет права уронить хук. Под set -e неудачная запись в
# stderr (закрытый дескриптор - обычное дело для графических клиентов git и
# headless-обёрток) обрывала скрипт ДО exit 0: человека запирала ровно та
# ветка, которая обязана его выпустить, и без единой строки объяснения.
say() {
    printf '%s\n' "$*" >&2 || :
}

# Как отключить хук - зависит от того, чем он подключён, и вслепую советовать
# тут нечего. Команда "git config --unset core.hooksPath" выглядит безобидно,
# но у человека с husky в этом ключе лежит .husky/_, и она убирает не наш хук,
# а ВЕСЬ его набор - молча, без ошибки. А если ключ задан глобально, та же
# команда правит локальный конфиг, возвращает 5, не печатает ничего, и человек,
# выполнивший предложенное, остаётся заперт. Поэтому показываем, где ключ задан,
# и объясняем, что убирать.
advise_how_to_disable() {
    say "pre-commit: чтобы отключить, сначала посмотрите, чем хук подключён:"
    say "pre-commit:   git config --show-origin --get core.hooksPath"
    say "pre-commit: если это .githooks - уберите ключ там, где он задан;"
    say "pre-commit: если что-то другое (.husky/_ и подобное) - наш хук зовётся"
    say "pre-commit: строкой из вашего менеджера хуков, убирать надо её."
    say "pre-commit: если команда не вывела ничего - ключ не задан вовсе:"
    say "pre-commit: так работает lefthook и обычный .git/hooks/pre-commit."
    say "pre-commit: тогда уберите вызов там, где вписали (lefthook.yml или"
    say "pre-commit: сам файл хука)."
}

# Короткая форма - для веток, которые коммит ПРОПУСКАЮТ. Там человек не
# заперт, ему ничего не нужно прямо сейчас, а десять строк дерева решений
# печатались бы на каждом коммите, пока он не поставит Питон. Проверено:
# успешный коммит выдавал двенадцать строк. Ровно тот шум, про который
# проверка сама предупреждает в комментариях: он приучает пролистывать
# вывод, а оттуда рукой подать до --no-verify.
#
# Предупреждение про разрушительную команду остаётся и здесь: оно и есть
# главное, что нельзя терять при сокращении.
advise_briefly() {
    say "pre-commit: как отключить - README, раздел «Как отключить хук совсем»."
    say "pre-commit: ключ core.hooksPath вслепую не снимайте - у husky в нём"
    say "pre-commit: лежит свой набор, и он уберётся молча, без ошибки."
}

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO_ROOT" || exit 0

CHECKER="scripts/check_memory_index.py"
MEMORY_DIR="memory"

if [ ! -d "$MEMORY_DIR" ]; then
    # Папки может не быть по нормальной причине - проект просто не пользуется
    # этой схемой, и бурчать об этом на каждом коммите значит приучать
    # пролистывать вывод. Но если в ЭТОМ коммите папку удаляют, молчать
    # нельзя: индекс исчезает, строка импорта в конфиге агента повисает, и
    # самый разрушительный из возможных коммитов проходит без единой строки -
    # тот же перевёрнутый градиент громкости, ради которого чинили линтер.
    # Статус берём отдельно, а не у последней команды конвейера: там он
    # принадлежит `grep`, и «git не смог ответить» становится неотличимо от
    # «в коммите ничего нет». Двадцатью строками ниже тот же вопрос уже решён
    # так - двух манер в одном файле быть не должно, иначе читателю неясно,
    # какая из них правило. Наблюдаемой разницы тут нет (папки уже нет, хук в
    # обоих случаях выходит с нулём), поэтому и теста на это не будет:
    # ветка ненаблюдаема снаружи.
    REMOVAL=$(git diff --cached --name-only -- "$MEMORY_DIR" 2>/dev/null || true)
    REMOVAL_STATUS=$?
    if [ "$REMOVAL_STATUS" = 0 ] && [ -n "$REMOVAL" ]; then
        say "pre-commit: папка $MEMORY_DIR удаляется этим коммитом."
        say "pre-commit: проверять больше нечего, коммит не блокирую - но"
        say "pre-commit: строку импорта индекса в конфиге агента уберите тоже,"
        say "pre-commit: иначе она будет указывать в пустоту."
    fi
    exit 0
fi

if [ ! -f "$CHECKER" ]; then
    say "pre-commit: хук подключён, но $CHECKER не найден - проверка НЕ идёт."
    say "pre-commit: скопируйте scripts/ рядом с memory/ либо отключите хук."
    advise_briefly
    exit 0
fi

# Посреди rebase дерево в промежуточном состоянии, а обойти проверку нечем:
# у "git rebase --continue" своего --no-verify нет. Поэтому пропускаем - но
# ВСЛУХ: маркеры залипают (git am оставляет rebase-apply до --abort), и
# молчаливый пропуск выключил бы хук насовсем, а человек считал бы себя
# защищённым.
# Конфликтные merge / cherry-pick / revert сюда НЕ входят намеренно:
# склеивание конфликта - ровно тот момент, когда строки индекса и ломаются.
# Обойти проверку там можно, но по-разному: у merge свой --no-verify есть,
# а у cherry-pick и revert его нет - им нужен обычный "git commit --no-verify",
# который завершает текущий шаг. Хук подсказывает это в сообщении об ошибке.
GIT_DIR_PATH=$(git rev-parse --git-dir 2>/dev/null) || exit 0
for marker in rebase-merge rebase-apply; do
    if [ -e "$GIT_DIR_PATH/$marker" ]; then
        say "pre-commit: идёт rebase - проверка памяти пропущена."
        exit 0
    fi
done

# Проверять есть смысл, только когда память вообще участвует в коммите.
# Иначе незакоммиченная правка памяти блокировала бы посторонние коммиты -
# а память правится постоянно, это её нормальное состояние.
# Фильтр по видам изменений здесь не ставим намеренно: удаление файла - самый
# частый способ осиротить строку индекса, и отсеять его означало бы пропускать
# ровно тот случай, ради которого проверка и нужна.
# Код возврата git берём отдельно от grep: в конвейере он теряется, и упавший
# git становился неотличим от «памяти в коммите нет» - то есть тихим exit 0.
set +e
STAGED=$(git diff --cached --name-only -- "$MEMORY_DIR" 2>/dev/null)
STAGED_STATUS=$?
set -e
if [ "$STAGED_STATUS" != 0 ]; then
    say "pre-commit: git не смог перечислить изменения в $MEMORY_DIR (код $STAGED_STATUS)."
    say "pre-commit: память НЕ проверена - дело в окружении, не в памяти."
    exit 0
fi
if [ -z "$STAGED" ]; then
    exit 0
fi

# Строка импорта - то единственное, из-за чего индекс вообще попадает в
# контекст агента. Нет её - агент не увидит НИ ОДНОГО факта: папка на месте,
# всё внутри согласовано, а он про неё попросту не знает. Любая другая
# поломка стоит одного факта или ветки, эта - всех сразу.
#
# Смотрит сюда хук, а не проверка: проверка отвечает строго за папку памяти и
# наружу не выходит, это её граница с собственными тестами. А CLAUDE.md лежит
# ЭТАЖОМ ВЫШЕ. Хук и так работает с репозиторием целиком - место ему здесь.
#
# Это подпорка, а не гарантия: grep подтверждает, что строка написана, и
# молчит о том, подхватил ли её агент на самом деле. Поэтому предупреждение,
# а не блокировка, а настоящая проверка остаётся прежней - открыть новую
# сессию и спросить агента, что он знает из памяти.
#
# Имя индекса берём то же, что у проверки: иначе тот, кто задал своё ключом
# --index, получал бы предупреждение на ровном месте.
IMPORT_INDEX=MEMORY.md
# --get-all, а не --get: при ключе, заданном дважды через `git config --add`,
# --get молча отдаёт последнее значение, и первый набор ключей исчезает без
# слова. Склеиваем в одну строку - дальше она всё равно делится по пробелам.
IMPORT_ARGS=$(git config --get-all memorycheck.args 2>/dev/null | tr '\n' ' ' || true)
case "$IMPORT_ARGS" in
    # Обе формы: argparse принимает и «--index ИМЯ», и «--index=ИМЯ». Пока
    # ветка знала только первую, тот, кто написал вторую, получал на каждом
    # коммите шесть строк «агент не увидит НИ ОДНОГО факта» и совет вписать
    # НЕВЕРНУЮ строку импорта - с чужим именем индекса.
    *"--index="*)
        IMPORT_CANDIDATE=${IMPORT_ARGS#*--index=}
        IMPORT_CANDIDATE=${IMPORT_CANDIDATE%% *}
        [ -n "$IMPORT_CANDIDATE" ] && IMPORT_INDEX=$IMPORT_CANDIDATE
        ;;
    *"--index "*)
        IMPORT_CANDIDATE=${IMPORT_ARGS#*--index }
        IMPORT_CANDIDATE=${IMPORT_CANDIDATE%% *}
        [ -n "$IMPORT_CANDIDATE" ] && IMPORT_INDEX=$IMPORT_CANDIDATE
        ;;
esac
# Имя индекса приходит из настройки и уходит в регулярку grep. Точка в
# «my.index.md» совпала бы с любым символом, а «[» уронил бы grep - ошибка
# ушла бы в /dev/null и обернулась ложным предупреждением. Ищем как литерал.
#
# set +e обязателен: под set -e код упавшего sed обрывает ВЕСЬ скрипт до
# первого say, и человек получает отклонённый коммит без единой строки - тот
# самый режим отказа, ради которого say написан с «|| :». Не смогли
# экранировать - пропускаем проверку импорта целиком: пустой шаблон превратил
# бы grep в «совпадает со всем» и погасил бы предупреждение молча.
set +e
IMPORT_PATTERN=$(printf '%s' "$IMPORT_INDEX" | sed 's/[].[^$*\\\/]/\\&/g')
IMPORT_PATTERN_STATUS=$?
set -e
if [ "$IMPORT_PATTERN_STATUS" != 0 ] || [ -z "$IMPORT_PATTERN" ]; then
    say "pre-commit: не смог подготовить имя индекса для поиска - строку"
    say "pre-commit: импорта в конфиге агента на этот раз не проверяю."
    IMPORT_PATTERN=""
fi

# Молчим, когда конфига агента нет вовсе: судить не по чему, и проект,
# возможно, просто не пользуется этой схемой. Ругаемся только когда конфиг
# ЕСТЬ, а строки в нём нет - тогда это забытый шаг установки, а не догадка.
CONFIG_SEEN=""
IMPORT_SEEN=""
if [ -n "$IMPORT_PATTERN" ]; then
    for config in CLAUDE.md AGENTS.md .claude/CLAUDE.md .claude/AGENTS.md; do
        [ -f "$config" ] || continue
        CONFIG_SEEN=yes
        if grep -q "@[^[:space:]]*$IMPORT_PATTERN" "$config" 2>/dev/null; then
            IMPORT_SEEN=yes
            break
        fi
    done
fi

if [ -n "$CONFIG_SEEN" ] && [ -z "$IMPORT_SEEN" ]; then
    say "pre-commit: в конфиге агента нет строки «@$MEMORY_DIR/$IMPORT_INDEX»."
    say "pre-commit: без неё индекс не попадает в контекст, и агент не увидит"
    say "pre-commit: НИ ОДНОГО факта - память будет лежать мёртвым грузом."
    say "pre-commit: путь считается относительно файла, где написан: из"
    say "pre-commit: корневого CLAUDE.md - @$MEMORY_DIR/$IMPORT_INDEX, из"
    say "pre-commit: .claude/CLAUDE.md - @../$MEMORY_DIR/$IMPORT_INDEX."
fi

# Наличие команды ещё не значит, что это нужный Питон: на Windows "python3"
# часто оказывается заглушкой Microsoft Store, а "python" на старых системах -
# второй версией или Питоном старее нашей планки. Поэтому спрашиваем у
# кандидата версию, а не факт запуска.
PYTHON=""
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" \
           >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
    fi
done

if [ -z "$PYTHON" ]; then
    say "pre-commit: Python 3.9+ не найден, проверка памяти пропущена."
    say "pre-commit: это не значит, что память в порядке - проверка не запускалась."
    say "pre-commit: поставьте Python 3.9+ либо отключите хук."
    advise_briefly
    exit 0
fi

# Дополнительные ключи проверки - через настройку репозитория, например:
#   git config memorycheck.args "--allow-orphan templates/*.md"
# Без этого ключи из README (тот же --allow-orphan) у пользователя хука
# не работали бы вовсе: хук зовёт проверку сам и аргументов ниоткуда не брал.
# Значение уже собрано выше - тем же `--get-all`, а не `--get`. Разница не
# косметическая: настройку дописывают через `git config --add`, и `--get`
# молча отдаёт только последнее значение. Если в потерянном наборе было имя
# индекса, проверка искала не тот файл, отдавала код 2, а на коде 2 хук не
# блокирует - защита выключалась насовсем. Спасательный повтор тут не спасал:
# он возвращал ту же двойку.
EXTRA_ARGS=$IMPORT_ARGS

# Разбить строку на аргументы надо, а вот раскрывать шаблоны по текущему
# каталогу - категорически нет: хук работает из корня репозитория, и
# "--allow-orphan templates/*.md" превратился бы в найденные ТАМ пути.
# set -f выключает раскрытие, set -- разбивает по пробелам. Значение
# настройки оболочкой не разбирается: кавычки внутри него не работают.
set -f
# shellcheck disable=SC2086
set -- $EXTRA_ARGS

# Неотслеживаемые файлы памяти из проверки исключаем. Git в коммит их не
# берёт, а проверка ходит по диску - и черновик, который человек ещё пишет,
# блокировал совершенно здоровый коммит: «файл не упомянут в индексе» про
# файл, которого в коммите нет.
#
# Ложная тревога дороже пропуска. Пропущенную поломку поймает CI на входе в
# основную ветку, а тревога бьёт по человеку напрямую и учит жать
# --no-verify - вместе с ней он выключает проверку целиком, со всеми L1 и L2
# разом. Оборотная сторона названа в README: забытый `git add` файла хук
# по-прежнему пропускает.
#
# Исключаются ТОЛЬКО файлы, о которых git не знает вовсе. Отслеживаемые - в
# том числе с несохранёнными правками и удалённые - проверяются как обычно:
# они в репозитории. Стоит сделать `git add` черновика, и он тут же
# перестаёт быть исключением.
# core.quotePath отключаем: по умолчанию он включён, и любое имя с кириллицей
# приезжает в кавычках и с восьмеричным экранированием. Для русскоязычного
# проекта «черновик.md» - имя по умолчанию, и такой файл не исключался, то
# есть блокировал здоровый коммит. С quotePath=false в кавычках остаются
# только управляющие символы, кавычка и обратный слэш - их ветка ниже
# по-прежнему ловит честно.
#
# Два запроса, а не один: `--exclude-standard` не перечисляет файлы, спрятанные
# через .gitignore, а прятать там заготовки - естественный способ. Линтер
# ходит по диску и такие файлы видит, поэтому исключать надо и их.
DRAFTS=$(git -c core.quotePath=false ls-files --others --exclude-standard \
             -- "$MEMORY_DIR" 2>/dev/null || true)
IGNORED=$(git -c core.quotePath=false ls-files --others --ignored \
              --exclude-standard -- "$MEMORY_DIR" 2>/dev/null || true)
if [ -n "$IGNORED" ]; then
    DRAFTS=$(printf '%s\n%s' "$DRAFTS" "$IGNORED" | grep -v '^$' || true)
fi

# Внутрь каталогов на точку проверка не заходит вовсе, поэтому исключать их
# файлы незачем - а они съедали бюджет. Реальный случай: .gitignore прячет
# memory/.cache/ с сотнями файлов, бюджет кончается, и настоящий черновик
# остаётся неисключённым - ложная тревога от той самой починки, которая
# ложную тревогу и снимала.
if [ -n "$DRAFTS" ]; then
    DRAFTS=$(printf '%s\n' "$DRAFTS" | grep -v '/\.[^/]*/' || true)
fi

# Файл, который ЭТОТ коммит удаляет из репозитория, тут же становится
# неотслеживаемым - и механизм исключения вычёркивал ровно его. Из-за этого
# `git rm --cached` уносил память из репо, а хук молчал: на диске всё на
# месте, проверке претензий нет. Вычитаем такие пути из черновиков.
# Те же два ключа, что у запроса черновиков, и по тем же причинам.
# core.quotePath=false: без него имя с кириллицей приезжает в кавычках и
# с восьмеричным экранированием, и две стороны сравнения говорят на
# разных языках - вычитание не срабатывает никогда. Для русскоязычного
# проекта это значит, что вся починка выключена.
#
# --no-renames: git по умолчанию склеивает удаление с добавлением в
# переименование, если содержимое похоже на половину, и тогда
# --diff-filter=D не возвращает НИЧЕГО. Гарантия не должна зависеть от
# эвристики похожести.
# Запроса ДВА, и это не дублирование. Вычитанию из черновиков нужны
# НАСТОЯЩИЕ удаления: путь, ставший источником переименования, из репозитория
# не уходит - уходит имя, содержимое переехало. Пока вычитание брало и такие
# пути, `git mv zametka.md zapiska.md` плюс новый черновик по освободившемуся
# имени давал ложный L2 на файл, которого в коммите нет, - ровно та тревога,
# ради снятия которой исключение и написано.
#
# Заметке об уходе индекса нужен обратный ответ: если индекс переименовали,
# под старым именем он из репозитория ушёл и строка импорта повисла.
REMOVED=$(git -c core.quotePath=false diff --cached \
              --name-only --diff-filter=D -- \
              "$MEMORY_DIR" 2>/dev/null || true)
GONE=$(git -c core.quotePath=false diff --cached \
           --name-only --no-renames --diff-filter=D -- \
           "$MEMORY_DIR" 2>/dev/null || true)
if [ -n "$REMOVED" ] && [ -n "$DRAFTS" ]; then
    KEPT=""
    OLD_IFS=$IFS
    IFS='
'
    for draft in $DRAFTS; do
        case "
$REMOVED
" in
            *"
$draft
"*) continue ;;
        esac
        KEPT="${KEPT}${draft}
"
    done
    IFS=$OLD_IFS
    DRAFTS=$KEPT
fi

# Проверка ходит по диску и про git не знает ничего, поэтому про уход памяти
# ИЗ РЕПОЗИТОРИЯ сказать может только хук. Не блокируем - удаление бывает
# намеренным, - но говорим: индекс уходит, а строка импорта в конфиге агента
# остаётся указывать в пустоту.
case "
$GONE
" in
    *"
$MEMORY_DIR/$IMPORT_INDEX
"*)
        say "pre-commit: $MEMORY_DIR/$IMPORT_INDEX уходит из репозитория этим коммитом."
        say "pre-commit: на диске файл остаётся, поэтому проверке претензий нет."
        say "pre-commit: коммит не блокирую - но строку импорта индекса в конфиге"
        say "pre-commit: агента уберите тоже, иначе она укажет в пустоту."
        ;;
esac

DRAFT_COUNT=0
if [ -n "$DRAFTS" ]; then
    # `|| true` гасит статус упавшего grep, поэтому проверяем результат, а
    # не код: пустая строка тут означала бы `[ "" -gt 0 ]` внутри `if`,
    # освобождённого от set -e, - то есть исключения не применялись бы МОЛЧА,
    # без единой строки объяснения. Тот же сторож, что у замера длины ниже.
    DRAFT_COUNT=$(printf '%s\n' "$DRAFTS" | grep -c . || true)
    case "$DRAFT_COUNT" in
        ''|*[!0-9]*)
            say "pre-commit: не смог сосчитать черновики -"
            say "pre-commit: исключения не применяю, они всплывут сиротами."
            DRAFT_COUNT=0
            DRAFTS=""
            ;;
    esac
fi

# Имя с управляющими символами git отдаёт в кавычках и с экранированием.
# Разбирать это в sh - отдельная задача; такой файл просто не исключаем, и он
# честно заблокирует коммит, вместо того чтобы молча просочиться.
QUOTED=$(printf '%s\n' "$DRAFTS" | grep '^"' || true)
if [ -n "$QUOTED" ]; then
    say "pre-commit: имена в кавычках из проверки не исключаю, их $(printf '%s\n' "$QUOTED" | grep -c .):"
    say "pre-commit: $(printf '%s' "$QUOTED" | head -1)"
    DRAFTS=$(printf '%s\n' "$DRAFTS" | grep -v '^"' || true)
    # Счётчик пересчитываем: он набран ДО отсева, и если в кавычках были все
    # черновики, дальше блок исключений уходит работать по пустому списку и
    # печатает «не смог подготовить исключения» - жалобу на несуществующий
    # сбой. Заодно число в сообщении о бюджете перестаёт быть завышенным.
    DRAFT_COUNT=0
    if [ -n "$DRAFTS" ]; then
        DRAFT_COUNT=$(printf '%s\n' "$DRAFTS" | grep -c . || true)
        case "$DRAFT_COUNT" in
            ''|*[!0-9]*) DRAFT_COUNT=0; DRAFTS="" ;;
        esac
    fi
fi

# Исключения черновиков держим ОТДЕЛЬНО от ключей пользователя. Пока они
# лежали вперемешку в "$@", спасательный повтор «без ключей» выбрасывал и то и
# другое: при опечатке в memorycheck.args хук блокировал здоровый коммит из-за
# черновика и объяснял это настройкой - человек шёл чинить не туда.
#
# Один sed на ВЕСЬ список, а не форк на каждый черновик. Прежде их было по
# одному на файл, и хук платил около 105 мс за каждый: 230 черновиков - 41
# секунда, 1333 - почти четыре минуты. Коммит, который думает сорок секунд,
# приучает к --no-verify не хуже ложной тревоги.
#
# Три подстановки за один проход: срезать префикс папки памяти (ключ ждёт путь
# относительно неё), обезвредить символы шаблона (ключ принимает ШАБЛОН, и
# «notes[1].md» иначе сам себе не соответствует) и приклеить ключ через `=`
# (отдельным словом argparse принимал имя на дефис за ключ, разбор падал, и
# один черновик «-x.md» выключал защиту насовсем).
#
# set +e обязателен: под set -e код упавшего sed оборвал бы весь скрипт до
# первого say, и человек получил бы отклонённый коммит без единой строки.
DRAFT_ARGS=""
if [ "$DRAFT_COUNT" -gt 0 ]; then
    set +e
    DRAFT_ARGS=$(printf '%s\n' "$DRAFTS" | grep . \
        | sed -e "s|^$MEMORY_DIR/||" -e 's/[][*?]/[&]/g' \
              -e 's|^|--allow-orphan=|')
    ESCAPE_STATUS=$?
    set -e
    if [ "$ESCAPE_STATUS" != 0 ] || [ -z "$DRAFT_ARGS" ]; then
        say "pre-commit: не смог подготовить исключения для черновиков -"
        say "pre-commit: проверка пойдёт по всей папке, они всплывут сиротами."
        DRAFT_ARGS=""
    fi
fi

# Бюджет: меряем ВСЮ будущую строку аргументов - и исключения черновиков, и
# ключи пользователя, - и сравниваем с настоящей границей командной строки.
#
# Считается длина, а не число файлов: `--allow-orphan=` плюс путь БЕЗ
# префикса папки памяти, то есть двести коротких имён проходят, а сто сорок
# длинных - нет. Замер границы на Windows: 32169 байт проходит, 32689 даёт
# код 126. Потолок 32000 оставляет на саму команду около сотни байт.
#
# У бюджета ровно два исхода, и оба - отклонённый коммит: потолок выше
# настоящей границы переполняет argv и даёт 126 без единого слова, потолок
# ниже выбрасывает исключения и заваливает человека ложными L2 на файлы,
# которых в коммите нет. В обе стороны уже попадали: 20000 отклоняли
# здоровый коммит на 780 коротких черновиках; 30000 при замере ВМЕСТЕ с
# ключами списывали запас на ключи дважды, и три черновика при длинном
# memorycheck.args объявлялись «слишком многими».
#
# Замер стоит ВНЕ ветки о черновиках: при нуле черновиков переполнить строку
# могут одни только ключи, и выбрасывать тогда нечего - но сказать надо.
#
# set +e и проверка статуса - по той же причине, что у соседнего блока:
# под set -e упавший `wc` или `tr` обрывал хук до первого слова, и человек
# получал отклонённый коммит с пустым выводом. Отдельно проверяем, что вышло
# ЧИСЛО: при упавшем `wc` статус конвейера берётся у `tr` и остаётся нулевым,
# длина выходит пустой, а сравнение внутри `if` от set -e освобождено - то
# есть бюджет молча выключался ровно там, где должен был сработать.
DRAFT_BYTES=0
set +e
DRAFT_BYTES=$(printf '%s%s' "$DRAFT_ARGS" "$EXTRA_ARGS" | wc -c | tr -d ' ')
MEASURE_STATUS=$?
set -e
MEASURE_OK=1
[ "$MEASURE_STATUS" = 0 ] || MEASURE_OK=0
case "$DRAFT_BYTES" in
    ''|*[!0-9]*) MEASURE_OK=0 ;;
esac
if [ "$MEASURE_OK" = 0 ]; then
    # Длину узнать не удалось. Из двух исходов выбираем громкий: отказаться
    # от исключений - это шум ложных сирот с объяснением, а пойти дальше
    # вслепую - переполненный argv и код 126 без единой строки.
    say "pre-commit: не смог измерить длину аргументов -"
    say "pre-commit: исключения черновиков не применяю, они всплывут сиротами."
    DRAFT_ARGS=""
    DRAFT_BYTES=0
fi
# Замер настоящей границы на Windows: 32169 байт проходит, 32689 даёт код
# 126. Потолок 32000 оставляет на саму команду около сотни байт и НЕ
# закладывает второй раз то, что уже посчитано.
if [ "$DRAFT_BYTES" -gt 32000 ]; then
    if [ -n "$DRAFT_ARGS" ]; then
        say "pre-commit: неотслеживаемых файлов в $MEMORY_DIR слишком много ($DRAFT_COUNT,"
        say "pre-commit: $DRAFT_BYTES байт аргументов) - в командную строку они не влезут."
        say "pre-commit: по одному их не исключаю, проверка пойдёт по всей папке."
        DRAFT_ARGS=""
    else
        # Черновиков нет - значит длину набрали ключи пользователя, и
        # выбрасывать нечего. Сказать всё равно надо: иначе запуск упрётся в
        # предел командной строки и человек получит код 126 без объяснения.
        say "pre-commit: memorycheck.args слишком длинный ($DRAFT_BYTES байт) -"
        say "pre-commit: в командную строку он может не влезть, укоротите его."
    fi
fi

# Порядок важен: EXTRA_ARGS делятся пробелами, DRAFT_ARGS - переводами строк,
# потому что в пути пробел законен, а перевод строки сюда не доходит (такое
# имя git отдаёт в кавычках, и ветка выше его отсеивает).
OLD_IFS=$IFS
IFS='
'
set -- "$@" $DRAFT_ARGS
IFS=$OLD_IFS

set +e
"$PYTHON" "$CHECKER" "$MEMORY_DIR" --quiet "$@"
STATUS=$?
set -e

# Опечатка в memorycheck.args даёт код 2 - и блокировка выключалась насовсем,
# молча. Настройку ставят один раз и забывают, а подсказку, которая печатается
# на каждом коммите, перестают читать: проверено, файл-сирота уезжал в коммит
# с кодом 0. Это тихий отказ ровно того вида, ради которого написана сама
# проверка, только внутри неё.
#
# Поэтому переспрашиваем БЕЗ ключей ПОЛЬЗОВАТЕЛЯ - но с исключениями
# черновиков: они не настройка, а поправка на то, чего в коммите нет. Прежде
# повтор шёл вовсе без аргументов и выбрасывал их заодно; при опечатке в
# настройке хук блокировал здоровый коммит из-за черновика и объяснял это
# настройкой, то есть отправлял чинить не туда.
if [ "$STATUS" = 2 ] && [ -n "$EXTRA_ARGS" ]; then
    OLD_IFS=$IFS
    IFS='
'
    set -- $DRAFT_ARGS
    IFS=$OLD_IFS
    set +e
    "$PYTHON" "$CHECKER" "$MEMORY_DIR" --quiet "$@"
    RETRY=$?
    set -e
    if [ "$RETRY" != 2 ]; then
        say "pre-commit: ключи из memorycheck.args проверка не приняла -"
        say "pre-commit: прогон сделан БЕЗ них, и сейчас они не действуют:"
        say "pre-commit:   git config --get-all memorycheck.args"
        STATUS=$RETRY
    fi
fi
# Раскрытие шаблонов было выключено с самого разбора настройки: между этими
# двумя точками мы только собираем аргументы и зовём проверку, а раскрывать
# там нечего и незачем. Одна точка включения вместо двух - и `set -f` в файле
# ровно один, а не два похожих.
set +f

case "$STATUS" in
    0)
        exit 0
        ;;
    2)
        # Проверка не смогла выполниться - это не нарушение памяти.
        say "pre-commit: проверку выполнить не удалось (см. выше), коммит не блокирую."
        exit 0
        ;;
    1)
        say "pre-commit: память и индекс разошлись - см. список выше."
        say "pre-commit: разовый обход - git commit --no-verify"
        # У cherry-pick и revert своего --no-verify нет (в отличие от merge),
        # поэтому "--continue --no-verify" человек не наберёт при всём желании.
        # Обычный commit завершает текущий шаг; остальные шаги диапазона
        # продолжает --continue. НЕ --quit: он бросает очередь молча, и
        # оставшиеся коммиты диапазона просто пропадают.
        if [ -e "$GIT_DIR_PATH/CHERRY_PICK_HEAD" ]; then
            say "pre-commit: идёт cherry-pick, своего --no-verify у него нет:"
            say "pre-commit:   git commit --no-verify"
            say "pre-commit: если переносили диапазон, продолжите остальные:"
            say "pre-commit:   git cherry-pick --continue"
            say "pre-commit: если коммит был один - всё, --continue не нужен."
        elif [ -e "$GIT_DIR_PATH/REVERT_HEAD" ]; then
            say "pre-commit: идёт revert, своего --no-verify у него нет:"
            say "pre-commit:   git commit --no-verify"
            say "pre-commit: если откатывали диапазон, продолжите остальные:"
            say "pre-commit:   git revert --continue"
            say "pre-commit: если коммит был один - всё, --continue не нужен."
        fi
        exit "$STATUS"
        ;;
    *)
        # 126/127 - не запустилось, 130 - прервали с клавиатуры. Называть это
        # "память разъехалась" - врать: память в этих случаях не проверена.
        say "pre-commit: проверка завершилась необычно (код $STATUS),"
        say "pre-commit: память НЕ проверена - дело в окружении, не в памяти."
        # Раз блокируем - обязаны сказать, как выйти: иначе человек заперт.
        say "pre-commit: разовый обход - git commit --no-verify"
        advise_how_to_disable
        exit "$STATUS"
        ;;
esac
